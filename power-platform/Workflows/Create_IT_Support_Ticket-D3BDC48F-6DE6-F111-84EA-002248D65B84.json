            "operationMetadataId": "c0611b6b-7a0d-44de-b4e8-f133bb35e265"
          },
          "type": "Response",
          "kind": "Skills",
          "inputs": {
            "statusCode": 200,
            "body": {
              "ticket_status": "New",
              "ticket_id": "@outputs('Register_Support_Ticket')?['body/kfp_ticketreference']",
              "confirmation_message": "Your support ticket has been created successfully.",
              "ticket_created": "Yes"
