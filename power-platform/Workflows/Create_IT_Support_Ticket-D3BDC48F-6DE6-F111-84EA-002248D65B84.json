            "schema": {
              "type": "object",
              "properties": {
                "ticket_status": {
                  "title": "ticket_status",
                  "x-ms-dynamically-added": true,
                  "type": "string"
                },
                "ticket_id": {
                  "title": "ticket_id",
                  "x-ms-dynamically-added": true,
                  "type": "string"
                },
                "confirmation_message": {
                  "title": "confirmation_message",
                  "x-ms-dynamically-added": true,
                  "type": "string"
                },
                "ticket_created": {
                  "title": "ticket_created",
                  "x-ms-dynamically-added": true,
                  "type": "boolean"
                }
              }
            }
          }
        },
        "Determine_Request_Category": {
          "runAfter": {
            "Initialize_Request_Priority": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "30116f1f-5317-478f-bd05-4d6b7aee9501"
          },
          "type": "SetVariable",
          "inputs": {
            "name": "varCategory",
            "value": "@if(equals(triggerBody()?['text_2'],'Network'),843250000,\r\nif(equals(triggerBody()?['text_2'],'VPN'),843250001,\r\nif(equals(triggerBody()?['text_2'],'Email'),843250002,\r\nif(equals(triggerBody()?['text_2'],'Application'),843250003,\r\nif(equals(triggerBody()?['text_2'],'Hardware'),843250004,\r\nif(equals(triggerBody()?['text_2'],'Software'),843250005,\r\nif(equals(triggerBody()?['text_2'],'Access'),843250006,\r\nif(equals(triggerBody()?['text_2'],'Other'),843250007,0))))))))"
          }
        },
        "Determine_Request_Priority": {
          "runAfter": {
            "Determine_Request_Category": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "12b47d65-0b0b-4946-84e8-d497cc70515e"
          },
          "type": "SetVariable",
          "inputs": {
            "name": "varPriority",
            "value": "@if(equals(triggerBody()?['text_3'],'Low'),843250000,\r\nif(equals(triggerBody()?['text_3'],'Medium'),843250001,\r\nif(equals(triggerBody()?['text_3'],'High'),843250002,\r\nif(equals(triggerBody()?['text_3'],'Critical'),843250003,0))))"
          }
        }
      }
