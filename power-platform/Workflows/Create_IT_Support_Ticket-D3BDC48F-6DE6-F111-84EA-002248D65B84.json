          "inputs": {
            "variables": [
              {
                "name": "varPriority",
                "type": "integer",
                "value": 0
              }
            ]
          }
        },
        "Confirm_Ticket_Registration": {
          "runAfter": {
            "Register_Support_Ticket": [
              "Succeeded"
