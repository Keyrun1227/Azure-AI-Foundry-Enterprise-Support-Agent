            ]
          },
          "metadata": {
            "operationMetadataId": "c1478f84-5fa7-4de7-af69-b206e9c324df"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "CreateRecord",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "kfp_itsupporttickets",
              "item/kfp_category": "@variables('varCategory')",
              "item/kfp_description": "@triggerBody()['text_1']",
              "item/kfp_priority": "@variables('varPriority')",
              "item/kfp_status": 843250000,
              "item/kfp_affectedservice": "@triggerBody()['text_4']",
              "item/kfp_location": "@triggerBody()['text_5']",
              "item/kfp_ticketreference": "@concat('INC-', toUpper(substring(replace(guid(),'-',''),0,8)))",
              "item/kfp_ticketsubject": "@triggerBody()['text']"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Initialize_Request_Category": {
          "runAfter": {},
          "metadata": {
            "operationMetadataId": "16d27d61-4058-4549-b121-16ff4511b523"
          },
